{
  "uid": "etch-compose",
  "title": "Etch",
  "description": "API, процесс api, сервер и логи для запуска через docker compose. Данные Prometheus каждые 15 секунд.",
  "tags": ["etch", "compose"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "15s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Сервис в логах",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": { "type": 1, "label": "service_name", "stream": "", "refId": "LokiVariableQueryEditor-VariableQuery" },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": { "selected": true, "text": ["etch-api"], "value": ["etch-api"] }
      }
    ]
  },
  "panels": [
    { "id": 1, "type": "row", "title": "Обзор", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 } },
    {
      "id": 2, "type": "stat", "title": "API доступен",
      "description": "Успешность последнего сбора /metrics с api. Это не проверка зависимостей сервиса.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "targets": [{ "refId": "A", "expr": "min(up{job=\"etch-api\"})", "instant": true }],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "нет данных",
          "mappings": [{ "type": "value", "options": { "0": { "text": "Ошибка сбора", "color": "red" }, "1": { "text": "Доступен", "color": "green" } } }],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" }
    },
    {
      "id": 3, "type": "stat", "title": "Запросов в секунду",
      "description": "Без healthcheck-ов и сбора метрик.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "targets": [{ "refId": "A", "expr": "sum(rate(http_requests_total{job=\"etch-api\",route!~\"/metrics|/openapi.json|/health|/ready\"}[$__rate_interval])) or vector(0)" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2, "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 4, "type": "stat", "title": "Ошибки 5xx",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "targets": [{ "refId": "A", "expr": "100 * (sum(rate(http_requests_total{job=\"etch-api\",route!~\"/metrics|/openapi.json|/health|/ready\",status=~\"5..\"}[$__rate_interval])) or vector(0)) / (sum(rate(http_requests_total{job=\"etch-api\",route!~\"/metrics|/openapi.json|/health|/ready\"}[$__rate_interval])) > 0) or vector(0)" }],
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 2, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 5 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 5, "type": "stat", "title": "Время ответа p95",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"etch-api\",route!~\"/metrics|/openapi.json|/health|/ready\"}[$__rate_interval])))" }],
      "fieldConfig": { "defaults": { "unit": "s", "noValue": "нет запросов", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.3 }, { "color": "red", "value": 1 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 6, "type": "stat", "title": "CPU сервера",
      "description": "Загрузка хоста целиком, а не отдельного контейнера.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "targets": [{ "refId": "A", "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{job=\"node-exporter\",mode=\"idle\"}[$__rate_interval])))" }],
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 1, "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 70 }, { "color": "red", "value": 90 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 7, "type": "stat", "title": "Память сервера",
      "description": "MemTotal минус MemAvailable: освобождаемый кеш не считается занятым.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "targets": [{ "refId": "A", "expr": "100 * (1 - avg(node_memory_MemAvailable_bytes{job=\"node-exporter\"}) / avg(node_memory_MemTotal_bytes{job=\"node-exporter\"}))" }],
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 1, "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 75 }, { "color": "red", "value": 90 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" }
    },

    { "id": 10, "type": "row", "title": "API: нагрузка", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 } },
    {
      "id": 11, "type": "timeseries", "title": "Запросы в секунду: всего",
      "description": "«Пользовательские» — без healthcheck-ов и сбора метрик. «Все» — вместе с ними.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(http_requests_total{job=\"etch-api\",route!~\"/metrics|/openapi.json|/health|/ready\"}[$__rate_interval])) or vector(0)", "legendFormat": "пользовательские" },
        { "refId": "B", "expr": "sum(rate(http_requests_all_total{job=\"etch-api\"}[$__rate_interval]))", "legendFormat": "все, включая служебные" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0, "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 12, "type": "timeseries", "title": "Запросы в секунду по HTTP-методам",
      "description": "Весь входящий поток, включая /metrics и healthcheck-и.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [{ "refId": "A", "expr": "sum by (method) (rate(http_requests_by_method_total{job=\"etch-api\"}[$__rate_interval]))", "legendFormat": "{{method}}" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0, "custom": { "lineWidth": 1, "fillOpacity": 20, "showPoints": "never", "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 13, "type": "timeseries", "title": "Ответы по статусам",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 14 },
      "targets": [{ "refId": "A", "expr": "sum by (status) (rate(http_requests_total{job=\"etch-api\",route!~\"/metrics|/openapi.json|/health|/ready\"}[$__rate_interval]))", "legendFormat": "{{status}}" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0, "custom": { "lineWidth": 1, "fillOpacity": 20, "showPoints": "never", "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 14, "type": "timeseries", "title": "Время ответа: p50 / p95 / p99",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 14 },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"etch-api\",route!~\"/metrics|/openapi.json|/health|/ready\"}[$__rate_interval])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"etch-api\",route!~\"/metrics|/openapi.json|/health|/ready\"}[$__rate_interval])))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"etch-api\",route!~\"/metrics|/openapi.json|/health|/ready\"}[$__rate_interval])))", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0, "custom": { "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 15, "type": "timeseries", "title": "Время ответа p95 по роутам",
      "description": "Какие endpoint отвечают медленнее остальных. Роут — шаблон пути.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 14 },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, method, route) (rate(http_request_duration_seconds_bucket{job=\"etch-api\",route!~\"/metrics|/openapi.json|/health|/ready\"}[$__rate_interval])))", "legendFormat": "{{method}} {{route}}" }],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0, "custom": { "lineWidth": 1, "fillOpacity": 0, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"], "sortBy": "Max", "sortDesc": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },

    { "id": 20, "type": "row", "title": "Процесс API", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 } },
    {
      "id": 21, "type": "timeseries", "title": "CPU процесса api",
      "description": "В ядрах: 1 = одно ядро занято полностью.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 23 },
      "targets": [{ "refId": "A", "expr": "sum(rate(process_cpu_seconds_total{job=\"etch-api\"}[$__rate_interval]))", "legendFormat": "api" }],
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 3, "min": 0, "custom": { "lineWidth": 2, "fillOpacity": 15, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 22, "type": "timeseries", "title": "Память процесса api",
      "description": "Resident set size. Постоянный рост без спада — повод искать утечку.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 23 },
      "targets": [{ "refId": "A", "expr": "sum(process_resident_memory_bytes{job=\"etch-api\"})", "legendFormat": "RSS" }],
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0, "custom": { "lineWidth": 2, "fillOpacity": 15, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 23, "type": "timeseries", "title": "Запросы в обработке",
      "description": "В моменты сбора метрик, включая сам /metrics, поэтому в простое обычно 1.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 23 },
      "targets": [{ "refId": "A", "expr": "sum(http_requests_in_progress{job=\"etch-api\"})", "legendFormat": "в обработке" }],
      "fieldConfig": { "defaults": { "unit": "none", "min": 0, "custom": { "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 24, "type": "timeseries", "title": "Открытые файловые дескрипторы",
      "description": "Сокеты и файлы процесса api. Упрётся в лимит — новые соединения начнут падать.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 23 },
      "targets": [
        { "refId": "A", "expr": "sum(process_open_fds{job=\"etch-api\"})", "legendFormat": "открыто" },
        { "refId": "B", "expr": "sum(process_max_fds{job=\"etch-api\"})", "legendFormat": "лимит" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "none", "min": 0, "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "scaleDistribution": { "type": "log", "log": 10 } } },
        "overrides": [{ "matcher": { "id": "byName", "options": "лимит" }, "properties": [{ "id": "custom.fillOpacity", "value": 0 }, { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } }] }]
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },

    { "id": 30, "type": "row", "title": "Сервер", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 } },
    {
      "id": 31, "type": "timeseries", "title": "Загрузка CPU",
      "description": "Ожидание диска и steal (время, отнятое гипервизором) уже входят в «занято».",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 32 },
      "targets": [
        { "refId": "A", "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{job=\"node-exporter\",mode=\"idle\"}[$__rate_interval])))", "legendFormat": "занято" },
        { "refId": "B", "expr": "100 * avg(rate(node_cpu_seconds_total{job=\"node-exporter\",mode=\"iowait\"}[$__rate_interval]))", "legendFormat": "ожидание диска" },
        { "refId": "C", "expr": "100 * avg(rate(node_cpu_seconds_total{job=\"node-exporter\",mode=\"steal\"}[$__rate_interval]))", "legendFormat": "steal" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 32, "type": "timeseries", "title": "Оперативная память",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 32 },
      "targets": [
        { "refId": "A", "expr": "avg(node_memory_MemTotal_bytes{job=\"node-exporter\"}) - avg(node_memory_MemAvailable_bytes{job=\"node-exporter\"})", "legendFormat": "занято" },
        { "refId": "B", "expr": "avg(node_memory_MemTotal_bytes{job=\"node-exporter\"})", "legendFormat": "всего" },
        { "refId": "C", "expr": "avg(node_memory_SwapTotal_bytes{job=\"node-exporter\"}) - avg(node_memory_SwapFree_bytes{job=\"node-exporter\"})", "legendFormat": "swap занято" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0, "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 33, "type": "timeseries", "title": "Load average на ядро",
      "description": "Выше 1 — процессам не хватает ядер.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 32 },
      "targets": [
        { "refId": "A", "expr": "avg(node_load1{job=\"node-exporter\"}) / count(count by (cpu) (node_cpu_seconds_total{job=\"node-exporter\",mode=\"idle\"}))", "legendFormat": "1 мин" },
        { "refId": "B", "expr": "avg(node_load5{job=\"node-exporter\"}) / count(count by (cpu) (node_cpu_seconds_total{job=\"node-exporter\",mode=\"idle\"}))", "legendFormat": "5 мин" }
      ],
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 2, "min": 0, "custom": { "lineWidth": 2, "fillOpacity": 0, "showPoints": "never", "thresholdsStyle": { "mode": "dashed" } }, "thresholds": { "mode": "absolute", "steps": [{ "color": "transparent", "value": null }, { "color": "red", "value": 1 }] } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 34, "type": "timeseries", "title": "Место на дисках",
      "description": "Доля занятого места по файловым системам, включая резерв. Выше 90% пора чистить.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "targets": [{ "refId": "A", "expr": "100 * (1 - node_filesystem_avail_bytes{job=\"node-exporter\",fstype!~\"tmpfs|ramfs\"} / (node_filesystem_size_bytes{job=\"node-exporter\",fstype!~\"tmpfs|ramfs\"} > 0))", "legendFormat": "{{mountpoint}}" }],
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 1, "min": 0, "max": 100, "custom": { "lineWidth": 2, "fillOpacity": 0, "showPoints": "never", "thresholdsStyle": { "mode": "dashed" } }, "thresholds": { "mode": "absolute", "steps": [{ "color": "transparent", "value": null }, { "color": "red", "value": 90 }] } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"], "sortBy": "Last *", "sortDesc": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 35, "type": "timeseries", "title": "Чтение и запись дисков",
      "description": "По блочным устройствам; запись рисуется вниз.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
      "targets": [
        { "refId": "A", "expr": "sum by (device) (rate(node_disk_read_bytes_total{job=\"node-exporter\"}[$__rate_interval]))", "legendFormat": "{{device}} чтение" },
        { "refId": "B", "expr": "sum by (device) (rate(node_disk_written_bytes_total{job=\"node-exporter\"}[$__rate_interval]))", "legendFormat": "{{device}} запись" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "Bps", "custom": { "lineWidth": 1, "fillOpacity": 20, "showPoints": "never" } },
        "overrides": [{ "matcher": { "id": "byRegexp", "options": ".* запись" }, "properties": [{ "id": "custom.transform", "value": "negative-Y" }] }]
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"], "sortBy": "Max", "sortDesc": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },

    { "id": 40, "type": "row", "title": "Логи", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 48 } },
    {
      "id": 41, "type": "timeseries", "title": "Строк логов в секунду по сервисам",
      "description": "api, worker и beat. Показывает, кто шумит больше всех.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 49 },
      "targets": [{ "refId": "A", "expr": "sum by (service_name) (rate({service_name=~\"etch-.+\"}[$__auto]))", "legendFormat": "{{service_name}}" }],
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 2, "min": 0, "custom": { "lineWidth": 1, "fillOpacity": 20, "showPoints": "never", "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"], "sortBy": "Mean", "sortDesc": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 42, "type": "timeseries", "title": "Предупреждения и ошибки бэкенда",
      "description": "Записи уровня warn и выше от api и celery.",
