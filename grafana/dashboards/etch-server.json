        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "100 * avg by (instance) (rate(node_cpu_seconds_total{job=\"node-exporter\",mode=\"steal\"}[$__rate_interval]))",
          "legendFormat": "Steal",
          "refId": "C",
          "range": true,
          "instant": false
