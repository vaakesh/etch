{
  "id": null,
  "uid": "etch-api",
  "title": "Etch API",
  "description": "HTTP-метрики Etch API: доступность сбора, нагрузка, методы, ошибки и время обработки. Данные собираются каждые 15 секунд.",
  "tags": [
    "etch",
    "api",
    "prometheus"
  ],
  "timezone": "browser",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "15s",
      "30s",
      "1m",
      "5m"
    ],
    "time_options": [
      "5m",
      "15m",
      "1h",
      "6h",
      "12h",
      "24h",
      "2d",
      "3d"
    ]
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Доступность API",
      "description": "Успешность последнего сбора /metrics для всех экземпляров API. 1 = доступен, 0 = ошибка сбора. Это не проверка всех зависимостей сервиса.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Ошибка сбора",
                  "color": "red"
                },
                "1": {
                  "text": "Доступен",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "min(up{job=\"etch-api\"})",
          "legendFormat": "API",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Все запросы за период",
      "description": "Оценка количества запросов за выбранный период по increase. Включает /metrics и /openapi.json. Учитывает сбросы счётчика при рестарте; результат может быть дробным.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(increase(http_requests_all_total{job=\"etch-api\"}[$__range]))",
          "legendFormat": "Запросы",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Ошибки 5xx, %",
      "description": "Доля серверных ошибок среди завершённых запросов приложения за окно rate. Исключены /metrics и /openapi.json. При отсутствии запросов выводится No data.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "100 * (sum(rate(http_requests_total{job=\"etch-api\",route!~\"/metrics|/openapi.json\",status=~\"5..\"}[$__rate_interval])) or (sum(rate(http_requests_total{job=\"etch-api\",route!~\"/metrics|/openapi.json\"}[$__rate_interval])) * 0)) / (sum(rate(http_requests_total{job=\"etch-api\",route!~\"/metrics|/openapi.json\"}[$__rate_interval])) > 0)",
          "legendFormat": "5xx",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Запросы в обработке",
      "description": "Количество запросов на момент последнего сбора метрик. Включает сам запрос /metrics, поэтому на одном простаивающем экземпляре обычно равно 1. Короткие всплески между сборами могут быть пропущены.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(http_requests_in_progress{job=\"etch-api\"})",
          "legendFormat": "В обработке",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Нагрузка: запросы в секунду",
      "description": "Весь входящий трафик по общему счётчику и завершённые запросы приложения без /metrics и /openapi.json. Небольшая разница возможна из-за запросов, ещё находящихся в обработке.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(http_requests_all_total{job=\"etch-api\"}[$__rate_interval]))",
          "legendFormat": "Все запросы",
          "refId": "A",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(http_requests_total{job=\"etch-api\",route!~\"/metrics|/openapi.json\"}[$__rate_interval]))",
          "legendFormat": "Приложение",
          "refId": "B",
          "range": true,
          "instant": false
        }
      ]
    },
    {
