{
  "uid": "etch-kubernetes",
  "title": "Etch Kubernetes",
  "tags": ["etch", "kubernetes"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "15s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Сервис в логах",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": { "type": 1, "label": "service_name", "stream": "", "refId": "LokiVariableQueryEditor-VariableQuery" },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": { "selected": true, "text": ["etch-api"], "value": ["etch-api"] }
      }
    ]
  },
  "panels": [
    { "id": 1, "type": "row", "title": "Обзор", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 } },
    {
      "id": 2, "type": "stat", "title": "Подов api в работе",
      "description": "Сколько подов api отвечает Prometheus. Число меняет HPA: от 3 до 6.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "targets": [{ "refId": "A", "expr": "count(up{job=\"etch-api\"} == 1)", "instant": true }],
      "fieldConfig": { "defaults": { "unit": "none", "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 2 }, { "color": "green", "value": 3 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" }
    },
    {
      "id": 3, "type": "stat", "title": "Запросов в секунду",
      "description": "Все поды вместе, без проб и сбора метрик.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "targets": [{ "refId": "A", "expr": "sum(rate(http_requests_total{job=\"etch-api\",route!~\"/metrics|/openapi.json|/health|/ready\"}[$__rate_interval])) or vector(0)" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2, "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 4, "type": "stat", "title": "Ошибки 5xx",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "targets": [{ "refId": "A", "expr": "100 * (sum(rate(http_requests_total{job=\"etch-api\",route!~\"/metrics|/openapi.json|/health|/ready\",status=~\"5..\"}[$__rate_interval])) or vector(0)) / (sum(rate(http_requests_total{job=\"etch-api\",route!~\"/metrics|/openapi.json|/health|/ready\"}[$__rate_interval])) > 0) or vector(0)" }],
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 2, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 5 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 5, "type": "stat", "title": "Время ответа p95",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"etch-api\",route!~\"/metrics|/openapi.json|/health|/ready\"}[$__rate_interval])))" }],
      "fieldConfig": { "defaults": { "unit": "s", "noValue": "нет запросов", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.3 }, { "color": "red", "value": 1 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 6, "type": "stat", "title": "CPU сервера",
      "description": "В kind все ноды — контейнеры на одной машине, поэтому это загрузка хоста целиком.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "targets": [{ "refId": "A", "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{job=\"node-exporter\",mode=\"idle\"}[$__rate_interval])))" }],
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 1, "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 70 }, { "color": "red", "value": 90 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 7, "type": "stat", "title": "Память сервера",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "targets": [{ "refId": "A", "expr": "100 * (1 - avg(node_memory_MemAvailable_bytes{job=\"node-exporter\"}) / avg(node_memory_MemTotal_bytes{job=\"node-exporter\"}))" }],
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 1, "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 75 }, { "color": "red", "value": 90 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" }
    },

    { "id": 10, "type": "row", "title": "API: нагрузка", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 } },
    {
      "id": 11, "type": "timeseries", "title": "Запросы в секунду: всего",
      "description": "«Пользовательские» — без проб kubelet и сбора метрик. «Все» — вместе с ними.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(http_requests_total{job=\"etch-api\",route!~\"/metrics|/openapi.json|/health|/ready\"}[$__rate_interval])) or vector(0)", "legendFormat": "пользовательские" },
        { "refId": "B", "expr": "sum(rate(http_requests_all_total{job=\"etch-api\"}[$__rate_interval]))", "legendFormat": "все, включая пробы" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0, "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 12, "type": "timeseries", "title": "Запросы в секунду по подам",
      "description": "Как Service делит нагрузку между репликами. Без проб и сбора метрик.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [{ "refId": "A", "expr": "sum by (instance) (rate(http_requests_total{job=\"etch-api\",route!~\"/metrics|/openapi.json|/health|/ready\"}[$__rate_interval]))", "legendFormat": "{{instance}}" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0, "custom": { "lineWidth": 1, "fillOpacity": 20, "showPoints": "never", "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 13, "type": "timeseries", "title": "Ответы по статусам",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 14 },
      "targets": [{ "refId": "A", "expr": "sum by (status) (rate(http_requests_total{job=\"etch-api\",route!~\"/metrics|/openapi.json|/health|/ready\"}[$__rate_interval]))", "legendFormat": "{{status}}" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0, "custom": { "lineWidth": 1, "fillOpacity": 20, "showPoints": "never", "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 14, "type": "timeseries", "title": "Время ответа: p50 / p95 / p99",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 14 },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"etch-api\",route!~\"/metrics|/openapi.json|/health|/ready\"}[$__rate_interval])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"etch-api\",route!~\"/metrics|/openapi.json|/health|/ready\"}[$__rate_interval])))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"etch-api\",route!~\"/metrics|/openapi.json|/health|/ready\"}[$__rate_interval])))", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0, "custom": { "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 15, "type": "timeseries", "title": "Время ответа p95 по подам",
      "description": "Если один под заметно медленнее остальных, проблема в нём или в его ноде.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 14 },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, instance) (rate(http_request_duration_seconds_bucket{job=\"etch-api\",route!~\"/metrics|/openapi.json|/health|/ready\"}[$__rate_interval])))", "legendFormat": "{{instance}}" }],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0, "custom": { "lineWidth": 1, "fillOpacity": 0, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },

    { "id": 20, "type": "row", "title": "Поды: масштабирование и ресурсы", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 } },
    {
      "id": 21, "type": "timeseries", "title": "Число подов api",
      "description": "Ступеньки — работа HPA.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 23 },
      "targets": [{ "refId": "A", "expr": "count(up{job=\"etch-api\"} == 1)", "legendFormat": "подов в работе" }],
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0, "min": 0, "max": 7, "custom": { "lineWidth": 2, "fillOpacity": 15, "showPoints": "never", "lineInterpolation": "stepAfter" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 22, "type": "timeseries", "title": "CPU подов api, % от request",
      "description": "HPA считает среднее по подам и добавляет реплики выше 70%. Request у api — 100m.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 23 },
      "targets": [
        { "refId": "A", "expr": "100 * sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"etch\",container=\"api\"}[$__rate_interval])) / 0.1", "legendFormat": "{{pod}}" },
        { "refId": "B", "expr": "100 * avg(sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"etch\",container=\"api\"}[$__rate_interval]))) / 0.1", "legendFormat": "среднее (его видит HPA)" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "custom": { "lineWidth": 1, "fillOpacity": 0, "showPoints": "never", "thresholdsStyle": { "mode": "dashed" } }, "thresholds": { "mode": "absolute", "steps": [{ "color": "transparent", "value": null }, { "color": "red", "value": 70 }] } },
        "overrides": [{ "matcher": { "id": "byName", "options": "среднее (его видит HPA)" }, "properties": [{ "id": "custom.lineWidth", "value": 3 }] }]
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 23, "type": "timeseries", "title": "Запросы в обработке по подам",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 23 },
      "targets": [{ "refId": "A", "expr": "sum by (instance) (http_requests_in_progress{job=\"etch-api\"})", "legendFormat": "{{instance}}" }],
      "fieldConfig": { "defaults": { "unit": "none", "min": 0, "custom": { "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 24, "type": "timeseries", "title": "CPU по подам",
      "description": "Все поды namespace etch, в ядрах: 0.1 = 100m.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 31 },
      "targets": [{ "refId": "A", "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"etch\"}[$__rate_interval]))", "legendFormat": "{{pod}}" }],
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 3, "min": 0, "custom": { "lineWidth": 1, "fillOpacity": 20, "showPoints": "never", "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"], "sortBy": "Max", "sortDesc": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 25, "type": "timeseries", "title": "Память по подам",
      "description": "Все поды namespace etch. Под, упёршийся в limits.memory, будет убит (OOM).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 31 },
      "targets": [{ "refId": "A", "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"etch\"})", "legendFormat": "{{pod}}" }],
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0, "custom": { "lineWidth": 1, "fillOpacity": 0, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"], "sortBy": "Max", "sortDesc": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },

    { "id": 30, "type": "row", "title": "Сервер", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 40 } },
    {
      "id": 31, "type": "timeseries", "title": "Загрузка CPU",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 41 },
      "targets": [
        { "refId": "A", "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{job=\"node-exporter\",mode=\"idle\"}[$__rate_interval])))", "legendFormat": "занято" },
        { "refId": "B", "expr": "100 * avg(rate(node_cpu_seconds_total{job=\"node-exporter\",mode=\"iowait\"}[$__rate_interval]))", "legendFormat": "ожидание диска" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 32, "type": "timeseries", "title": "Оперативная память",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 41 },
      "targets": [
        { "refId": "A", "expr": "avg(node_memory_MemTotal_bytes{job=\"node-exporter\"}) - avg(node_memory_MemAvailable_bytes{job=\"node-exporter\"})", "legendFormat": "занято" },
        { "refId": "B", "expr": "avg(node_memory_MemTotal_bytes{job=\"node-exporter\"})", "legendFormat": "всего" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0, "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 33, "type": "timeseries", "title": "Load average на ядро",
      "description": "Выше 1 — процессам не хватает ядер.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 41 },
      "targets": [
        { "refId": "A", "expr": "avg(node_load1{job=\"node-exporter\"}) / count(count by (cpu) (node_cpu_seconds_total{job=\"node-exporter\",mode=\"idle\"}))", "legendFormat": "1 мин" },
        { "refId": "B", "expr": "avg(node_load5{job=\"node-exporter\"}) / count(count by (cpu) (node_cpu_seconds_total{job=\"node-exporter\",mode=\"idle\"}))", "legendFormat": "5 мин" }
      ],
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 2, "min": 0, "custom": { "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },

    { "id": 40, "type": "row", "title": "Логи", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 49 } },
    {
      "id": 41, "type": "timeseries", "title": "Строк логов в секунду по сервисам",
      "description": "Только namespace etch. Показывает, кто шумит больше всех.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 50 },
      "targets": [{ "refId": "A", "expr": "sum by (service_name) (rate({k8s_namespace_name=\"etch\"}[$__auto]))", "legendFormat": "{{service_name}}" }],
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 2, "min": 0, "custom": { "lineWidth": 1, "fillOpacity": 20, "showPoints": "never", "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"], "sortBy": "Mean", "sortDesc": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 42, "type": "timeseries", "title": "Предупреждения и ошибки бэкенда",
      "description": "Записи уровня warn и выше от api и celery.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 50 },
      "targets": [{ "refId": "A", "expr": "sum by (service_name, detected_level) (count_over_time({service_name=~\"etch-.*\"} | detected_level=~\"warn|error|critical|fatal\" [$__auto]))", "legendFormat": "{{service_name}} {{detected_level}}" }],
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0, "min": 0, "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 60, "showPoints": "never", "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 43, "type": "logs", "title": "Логи: $service",
      "description": "Сервис выбирается в списке вверху. У каждой записи есть k8s_pod_name — по нему видно, какая реплика её написала.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 58 },
      "targets": [{ "refId": "A", "expr": "{service_name=~\"$service\"}", "maxLines": 300 }],
      "options": { "showTime": true, "wrapLogMessage": true, "enableLogDetails": true, "sortOrder": "Descending", "dedupStrategy": "none", "showLabels": false, "prettifyLogMessage": false }
    }
  ]
}
