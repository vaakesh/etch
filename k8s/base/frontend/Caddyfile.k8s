{
	# tls завершается на gateway
	auto_https off
}

:8080 {
	@internal_probes path /health /health/* /api/health /api/health/* /ready /ready/* /api/ready /api/ready/*

	route {
		# gateway направляет пути проб сюда, чтобы они не были доступны снаружи
		respond @internal_probes "Not Found" 404
		header Strict-Transport-Security "max-age=31536000"
		header X-Content-Type-Options "nosniff"
		header Content-Security-Policy "frame-ancestors 'none'"
		header X-Robots-Tag "noindex, nofollow"
		encode zstd gzip

		# vite генерирует ассеты с хешем в имени; отсутствующий ассет должен отдавать 404, а не html
		handle /assets/* {
			root * /srv
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}

		handle {
			root * /srv
			route {
				try_files {path} /index.html
				header /index.html Cache-Control "no-cache"
			}
			file_server
		}
	}
}
