# Published ports bind only to 127.0.0.1. Qdrant gRPC stays inside the Compose network.
API_HOST_PORT=8002
API_PORT=8000
QDRANT_HOST_PORT=6335
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# Container address. For a local API, override QDRANT_URL in the environment.
QDRANT_URL=http://rag-qdrant:${QDRANT_HTTP_PORT}
CONTENT_DIR=content/ru
QDRANT_COLLECTION=etch_user_guide_ru
QDRANT_TIMEOUT=10
LLM_URL=https://api.openai.com/v1
LLM_MODEL=gpt-6-luna
LLM_API_KEY=
LLM_TIMEOUT=300
LLM_REASONING_EFFORT=medium
# Optional read token for Hugging Face downloads. Leave empty for anonymous access.
HF_TOKEN=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu
RERANKER_DTYPE=float32
RERANKER_BATCH_SIZE=8
RERANKER_MAX_LENGTH=1024
CANDIDATE_K=20
TOP_K=5
INIT_TIMEOUT=60
