# Public hostname for Caddy automatic HTTPS in production.
site_domain_prod=example.com

# Loopback port for the host Caddy in docker-compose-prod.yml; empty means 11100.
caddy_proxy_port=
# Loopback port for the host Prometheus to scrape api /metrics in docker-compose-prod.yml; empty means 11101.
api_metrics_port=

# Optional public client IPs allowed to access the production site and API; empty allows everyone.
allowed_ip_prod=

# Production image tag: full Git commit SHA published to GHCR
IMAGE_TAG=
