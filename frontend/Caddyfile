{$SITE_DOMAIN} {
	@blocked not remote_ip {$ALLOWED_IP_PROD}
	@api path /api /api/*
	@internal_probes path /health /health/* /api/health /api/health/* /ready /ready/* /api/ready /api/ready/*

	# Reject internal probes before serving files or proxying API requests.
	route {
		respond @blocked "Forbidden" 403
		# Health probes are available directly within the Docker network only.
		respond @internal_probes "Not Found" 404
		header Strict-Transport-Security "max-age=31536000"
		header X-Content-Type-Options "nosniff"
		header Content-Security-Policy "frame-ancestors 'none'"
		header X-Robots-Tag "noindex, nofollow"
		encode zstd gzip

		handle @api {
			# The largest legitimate request, a 500-card import, is about 300 KB.
			request_body {
				max_size 1MB
			}
			uri strip_prefix /api
			reverse_proxy api:8000
		}

		# Vite generates hashed assets; missing assets must return 404, not HTML.
		handle /assets/* {
			root * /srv
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}

		handle {
			root * /srv
			route {
				try_files {path} /index.html
				header /index.html Cache-Control "no-cache"
			}
			file_server
		}
	}
}

# Container healthcheck does not depend on external DNS or certificate issuance.
http://127.0.0.1:8080 {
	bind 127.0.0.1
	root * /srv
	file_server
}
