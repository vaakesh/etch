{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "typecheck:e2e": "tsc --project tsconfig.playwright.json",
    "test:e2e": "playwright test --project=mocked-chromium",
    "test:e2e:mocked": "playwright test",
    "test:e2e:integration": "PLAYWRIGHT_SUITE=integration playwright test",
    "test:e2e:visual": "PLAYWRIGHT_SUITE=visual playwright test",
    "test:e2e:ui": "playwright test --project=mocked-chromium --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:install": "playwright install chromium firefox webkit"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^7.18.1",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/playfair-display": "5.3.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
